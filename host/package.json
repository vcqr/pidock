{
  "name": "@pidock/host",
  "private": true,
  "version": "0.2.3",
  "description": "PiDock pi-host: stdio daemon embedding the pi coding agent SDK (multi-session)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/main.ts --compile --outfile ../target/pidock-host.exe",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:features": "bun run scripts/features-smoke.ts",
    "smoke:node": "node --experimental-strip-types scripts/smoke.ts",
    "smoke:extension": "bun run scripts/extension-smoke.ts",
    "smoke:config": "bun run scripts/config-smoke.ts",
    "smoke:experts": "bun run scripts/experts-smoke.ts",
    "verify:experts-config": "bun run scripts/experts-config-verify.ts",
    "e2e:server": "bun run ../server/scripts/fake-desktop.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@pidock/protocol": "workspace:*",
    "typebox": "1.1.38",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "ws": "^8.18.0"
  }
}